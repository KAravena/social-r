# ==============================================================================
# Social R — Cloud Configuration Environment Variables (Modern Supabase 2026)
# ==============================================================================
# SECURITY NOTICE:
# - SUPABASE_URL and SUPABASE_PUBLISHABLE_KEY are public and used by frontend/Edge Functions.
# - SUPABASE_SECRET_KEY is elevated/secret. STRICTLY for local administrative scripts.
#   NEVER commit this key or expose it to frontend code!
# - RUT_SECRET_KEY is our HMAC pepper. Configured manually in Edge Functions and local scripts.
# ==============================================================================

# Supabase Project URL (e.g., https://xyzcompany.supabase.co)
SUPABASE_URL=

# Supabase Modern Publishable Key (Public - Safe for frontend, format: sb_publishable_...)
SUPABASE_PUBLISHABLE_KEY=

# Supabase Modern Secret Key (Admin/Backend only - NEVER in frontend, format: sb_secret_...)
SUPABASE_SECRET_KEY=

# Privacy-First RUT HMAC Pepper Secret (32+ chars - local scripts & Edge Functions secret)
RUT_SECRET_KEY=

# Course & Cloud Sync Settings
CLOUD_SYNC_ENABLED=false
SYNC_DRAFTS_TO_CLOUD=false
COURSE_ID=intro-r
