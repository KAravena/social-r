{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://social-r.local/schema/exercise.schema.json",
  "title": "Social R Exercise Schema v1",
  "type": "object",
  "required": ["id", "course", "module", "order", "title", "instruction", "starter_code", "checks"],
  "additionalProperties": true,
  "properties": {
    "schema_version": {"type": ["integer", "string"], "default": 1},
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]*$"},
    "course": {"type": "string", "minLength": 1},
    "module": {"type": "string", "minLength": 1},
    "lesson": {"type": "string"},
    "order": {"type": "integer", "minimum": 0},
    "title": {"type": "string", "minLength": 1},
    "context": {"type": "string", "default": ""},
    "instruction": {"type": "string", "minLength": 1},
    "learning_objectives": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "r": {"type": "string"},
        "data": {"type": "string"},
        "social": {"type": "string"}
      }
    },
    "objectives": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "r": {"type": "string"},
        "data": {"type": "string"},
        "social": {"type": "string"}
      }
    },
    "ui": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "show_workflow_help": {"type": "boolean", "default": false},
        "show_objective": {"type": "boolean", "default": true}
      }
    },
    "difficulty": {
      "type": "string",
      "enum": ["intro", "beginner", "basic", "intermediate", "advanced"],
      "default": "beginner"
    },
    "exercise_type": {
      "type": "string",
      "enum": ["run", "complete", "modify", "write", "interpret", "code"],
      "default": "code"
    },
    "type": {
      "type": "string",
      "enum": ["run", "complete", "modify", "write", "interpret", "code"],
      "default": "code"
    },
    "starter_code": {"type": "string"},
    "setup_code": {"type": "string", "default": ""},
    "solution_code": {"type": "string", "default": ""},
    "persist_code": {"type": "boolean", "default": true},
    "time_limit_seconds": {"type": "integer", "minimum": 1, "maximum": 120, "default": 30},
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["type"],
        "additionalProperties": true,
        "properties": {
          "type": {"type": "string", "enum": ["result_equals", "object_exists", "object_value", "object_class", "custom_r", "standalone_query"]},
          "object": {"type": "string"},
          "expected": {},
          "class": {"type": "string"},
          "code": {"type": "string"},
          "message": {"type": "string"}
        }
      }
    },
    "diagnostics": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["when_r", "message"],
        "additionalProperties": false,
        "properties": {
          "when_r": {"type": "string"},
          "message": {"type": "string"},
          "type": {"type": "string", "enum": ["info", "warning", "error"], "default": "info"}
        }
      },
      "default": []
    },
    "hints": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["text"],
        "additionalProperties": false,
        "properties": {
          "title": {"type": "string"},
          "text": {"type": "string"},
          "code": {"type": "string"}
        }
      },
      "default": []
    },
    "success_message": {"type": "string", "default": "¡Muy bien!"},
    "xp": {"type": "integer", "minimum": 0, "default": 100},
    "progress": {
      "type": "object",
      "properties": {
        "xp": {"type": "integer", "minimum": 0}
      }
    },
    "next_exercise": {"type": ["string", "null"], "default": null},
    "navigation": {
      "type": "object",
      "properties": {
        "next": {"type": ["string", "null"]}
      }
    }
  }
}
